{
  "openapi": "3.1.0",
  "info": {
    "title": "NanoFile Agent Plugin API",
    "description": "OpenAPI specification for NanoFile local filesystem operations, lightning search, and privacy vault.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:39281",
      "description": "Local NanoFile Agent Bridge"
    }
  ],
  "paths": {
    "/api/items/search": {
      "post": {
        "operationId": "searchItems",
        "summary": "Unified lightning search across both files and folders",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string" },
                  "scope": { "type": "string", "enum": ["common", "global", "directory"] },
                  "directory": { "type": "string" },
                  "mode": { "type": "string", "enum": ["turbo", "realtime", "auto"] },
                  "limit": { "type": "integer" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Search results returned successfully" }
        }
      }
    },
    "/api/files/read": {
      "post": {
        "operationId": "readFileContent",
        "summary": "Read file text content safely",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "max_bytes": { "type": "integer" }
                },
                "required": ["path"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "File text content" }
        }
      }
    },
    "/api/files/write": {
      "post": {
        "operationId": "writeFileContent",
        "summary": "Create or overwrite file with text content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "content": { "type": "string" }
                },
                "required": ["path", "content"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Write status" }
        }
      }
    },
    "/api/metadata/get": {
      "post": {
        "operationId": "getItemMetadata",
        "summary": "Read comprehensive metadata, folder recursive size and item count",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": { "type": "string" }
                },
                "required": ["path"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Item metadata" }
        }
      }
    },
    "/api/vault/status": {
      "get": {
        "operationId": "getVaultStatus",
        "summary": "Query current privacy vault lock state",
        "responses": {
          "200": { "description": "Vault lock status" }
        }
      }
    }
  }
}
