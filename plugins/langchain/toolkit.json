{
  "toolkit_name": "NanoFileToolkit",
  "version": "1.0.0",
  "description": "Standard Agent toolkit wrapping NanoFile native desktop MCP operations for LangChain, LlamaIndex, and CrewAI.",
  "client_connection": {
    "type": "StdioServerParameters",
    "command": "nanofile.exe",
    "args": ["--mcp"]
  },
  "sub_toolkits": [
    {
      "name": "FileSystemToolkit",
      "tools": ["search_items", "operate_item", "batch_operate_items", "read_file_content", "write_file_content", "list_folder_contents", "create_folder"]
    },
    {
      "name": "MetadataToolkit",
      "tools": ["get_item_metadata", "get_media_metadata"]
    },
    {
      "name": "AssociationsToolkit",
      "tools": ["open_file", "open_folder", "get_file_default_app", "set_file_default_app", "get_folder_default_app", "set_folder_default_app"]
    },
    {
      "name": "TagsToolkit",
      "tools": ["list_all_tags", "delete_tag", "rename_tag", "get_item_tags", "set_item_tags", "remove_item_tags"]
    },
    {
      "name": "ApplicationsToolkit",
      "tools": ["search_apps", "launch_app", "uninstall_app"]
    },
    {
      "name": "FavoritesToolkit",
      "tools": ["get_favorites", "add_favorite", "remove_favorite"]
    }
  ]
}
